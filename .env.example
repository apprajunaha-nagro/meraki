# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="Meraki by Kritika"
VITE_APP_URL="https://www.merakibykritika.in"
VITE_API_URL="https://www.merakibykritika.in/api"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXXXX"
# Razorpay Key Secret NEVER goes in frontend env.
# Add it to backend/.env only:
# RAZORPAY_KEY_SECRET=your_secret_here

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="meraki_unsigned"
# Backend only:
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Analytics & Tag Manager ──────────────────────────────────────────
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GTM_CONTAINER_ID="GTM-XXXXXXX"

# ─── Meta Pixel ───────────────────────────────────────────────────────────────
VITE_META_PIXEL_ID="XXXXXXXXXXXXXXXXXX"

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER="919900000000"

# ─── Feature flags ────────────────────────────────────────────────────────────
VITE_ENABLE_COD="true"
VITE_ENABLE_GIFT_CARDS="true"
VITE_FREE_SHIPPING_THRESHOLD="1499"
