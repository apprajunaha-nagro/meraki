# ─── API Rewrite Rules ────────────────────────────────────────────────────────
RewriteEngine On

# If the request is for a real file or folder, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite all other requests to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
